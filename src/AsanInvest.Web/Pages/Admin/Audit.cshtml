@page
@model AuditModel
@{ ViewData["Title"] = "Audit jurnalı"; }
<div class="row between"><h1>Audit jurnalı</h1><form method="get" class="row"><input name="q" value="@Model.Q" placeholder="Axtar" maxlength="100" /><button class="btn small">Axtar</button></form></div>
<div class="card"><table><thead><tr><th>Vaxt</th><th>Kim</th><th>Kimin adından</th><th>Əməliyyat</th><th>Obyekt</th><th>Təfərrüat</th></tr></thead><tbody>
@foreach (var a in Model.Items) { <tr><td>@C.Local(a.At)</td><td>@a.ActorName</td><td>@(a.OnBehalfOfId is { } o ? C.UserName(o) : "")</td><td>@a.Action</td><td>@a.EntityType @a.EntityId</td><td>@a.Details</td></tr> }
</tbody></table></div>
<p class="hint">Son 300 qeyd göstərilir. Jurnal yalnız əlavə olunur, redaktə edilmir.</p>
