{
  "name": "asan-invest",
  "private": true,
  "version": "0.1.0",
  "description": "ASAN Invest — investor contact point with Azerbaijani institutions (TZ v4.0 Phase 1)",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "dotnet run --project server/AsanInvest.Api/AsanInvest.Api.csproj",
    "build": "dotnet build server/AsanInvest.sln",
    "start": "dotnet run --project server/AsanInvest.Api/AsanInvest.Api.csproj --no-build",
    "test": "dotnet test server/AsanInvest.sln",
    "lint": "dotnet build server/AsanInvest.sln --no-restore -warnaserror",
    "db:generate": "npm run prisma:generate -w server",
    "db:migrate": "npm run prisma:migrate -w server",
    "db:migrate:deploy": "npm run prisma:migrate:deploy -w server",
    "db:seed": "npm run prisma:seed -w server",
    "db:verify": "npm run db:verify -w server"
  }
}
