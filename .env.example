# PostgreSQL connection string.
# Production host must be in Azerbaijan (NFR-01). Local Docker is allowed for development.
DATABASE_URL=postgresql://asan:asan_dev_password@127.0.0.1:5432/asan_invest?schema=public

# API (Backend). Never commit real secrets.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
REQUIRE_EMAIL_VERIFICATION=false
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=refresh_token

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

DVX_COMPANY_REGISTRATION_URL=https://www.e-taxes.gov.az/

# Phase 2 feature flags (default off → Phase 1 fallbacks). Do not put live provider keys here.
OMBUDSMAN_ENABLED=false
DVX_SUBMIT_ENABLED=false
PAYMENTS_ENABLED=false
BANK_PILOT_ENABLED=false
PAYMENT_WEBHOOK_SECRET=

# Frontend (Vite). Same-origin /api/v1 is proxied to PORT during `npm run dev:client`.
VITE_API_BASE_URL=/api/v1
