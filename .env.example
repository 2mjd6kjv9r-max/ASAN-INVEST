# Copy to .env at the repository root for local development.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://asan:asan_dev_password@127.0.0.1:5432/asan_invest

# JWT secrets — generate unique values before any non-local deployment.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Optional: where KYC files are stored (local disk in MVP)
UPLOAD_DIR=./uploads

# Demo mode auto-verifies email on register. Set to "true" to require the stub token flow.
REQUIRE_EMAIL_VERIFICATION=false
